[Unit]
Description=SensorTrain Host Shutdown Agent
After=network-online.target microshift.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/sysconfig/sensortrain-shutdown-agent
ExecStart=/usr/bin/python3 /usr/local/libexec/sensortrain-shutdown-agent.py

Restart=always
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
